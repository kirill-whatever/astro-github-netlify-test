---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'HELLO' },
  { href: '/picture/', label: 'PICTURE' },
  { href: '/goodbye/', label: 'GOODBYE' },
];
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-inner">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={['nav-link', { active: currentPath === link.href }]}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>
